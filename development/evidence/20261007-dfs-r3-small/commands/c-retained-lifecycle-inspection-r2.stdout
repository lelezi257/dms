  "frozen_stop_code": "stop_one() {\n  local service=$1 pid deadline lifecycle\n  pid=$(read_pid \"$service\")\n  if [ -z \"$pid\" ] && [ -f \"$RUN_DIR/$(process_service \"$service\").launch\" ]; then\n    lifecycle=$(cat \"$RUN_DIR/$(process_service \"$service\").launch\")\n    case \"$lifecycle\" in \"$RUN_DIR/$(process_service \"$service\").lifecycle.\"*) ;; *) echo \"$service invalid managed launch\" >&2; return 1 ;; esac\n    [ -f \"$lifecycle/child\" ] || { echo \"$service startup child unknown; retained managed launch\" >&2; return 1; }\n    pid=$(identity_value pid \"$lifecycle/child\")\n    printf '%s\\n' \"$pid\" >\"$(pid_file \"$service\")\"\n    write_identity \"$service\" \"$lifecycle\"\n  fi\n  if [ -z \"$pid\" ]; then\n    # Never managed, or startup already reported failure and removed its PID.\n    [ ! -f \"$(identity_file \"$service\")\" ] || { echo \"$service missing managed pid; exit status unknown\" >&2; return 1; }\n    echo \"$service stopped\"\n    return 0\n  fi\n  deadline=$((SECONDS + TIMEOUT))\n  if is_running_pid \"$pid\"; then\n    if ! pid_identity_matches \"$service\" \"$pid\"; then\n      if is_running_pid \"$pid\"; then\n        echo \"$service pid file points to another live process: $pid\" >&2\n        return 1\n      fi\n    else\n      kill \"$pid\" 2>/dev/null || true\n    fi\n  fi\n  while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n    if ! is_running_pid \"$pid\"; then\n      if exit_status \"$service\" \"$pid\" >/dev/null; then\n        report_exit \"$service\" \"$pid\"\n        return $?\n      fi\n      # The wait owner can need a moment to publish its atomic receipt.\n    fi\n    sleep 0.05\n  done\n  if ! is_running_pid \"$pid\" && [ \"$TIMEOUT\" -ne 0 ]; then\n    report_exit \"$service\" \"$pid\"\n    return $?\n  fi\n  echo \"$service did not stop within ${TIMEOUT}s\" >&2\n  return 1\n}\n\n"
}
