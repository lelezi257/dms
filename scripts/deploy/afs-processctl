#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: afs-processctl [options] <start|stop|restart|status|uninstall> <meta|node|dfs|ownerfs|all>

Options:
  --prefix DIR        Program prefix. Default: /opt/afs
  --config-dir DIR    Config directory. Default: /etc/afs
  --run-dir DIR       PID directory. Default: /run/afs
  --log-dir DIR       Log directory. Default: /var/log/afs
  --timeout SEC       Stop/start wait timeout. Default: 20
  --json              Emit machine-readable status where supported.
  --no-readiness      Start process without REST or mount readiness checks.
USAGE
}

PREFIX=/opt/afs
CONFIG_DIR=/etc/afs
RUN_DIR=/run/afs
LOG_DIR=/var/log/afs
TIMEOUT=20
JSON=0
READINESS=1

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX=${2:-}; shift 2 ;;
    --config-dir) CONFIG_DIR=${2:-}; shift 2 ;;
    --run-dir) RUN_DIR=${2:-}; shift 2 ;;
    --log-dir) LOG_DIR=${2:-}; shift 2 ;;
    --timeout) TIMEOUT=${2:-}; shift 2 ;;
    --json) JSON=1; shift ;;
    --no-readiness) READINESS=0; shift ;;
    -h|--help) usage; exit 0 ;;
    start|stop|restart|status|uninstall) ACTION=$1; shift; break ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

ACTION=${ACTION:-}
TARGET=${1:-}
if [ -z "$ACTION" ] || [ -z "$TARGET" ]; then
  usage >&2
  exit 2
fi

case "$TARGET" in
  meta|node|dfs|ownerfs|all) ;;
  *) echo "target must be meta, node, dfs, ownerfs or all" >&2; exit 2 ;;
esac

mkdir -p "$RUN_DIR" "$LOG_DIR"

process_service() {
  case "$1" in
    meta) printf 'meta\n' ;;
    node|dfs|ownerfs) printf 'node\n' ;;
  esac
}

service_binary() {
  case "$(process_service "$1")" in
    meta) printf '%s/bin/afs-meta\n' "$PREFIX" ;;
    node) printf '%s/bin/afs-node\n' "$PREFIX" ;;
  esac
}

service_config() {
  case "$(process_service "$1")" in
    meta) printf '%s/meta.toml\n' "$CONFIG_DIR" ;;
    node) printf '%s/node.toml\n' "$CONFIG_DIR" ;;
  esac
}

pid_file() {
  printf '%s/%s.pid\n' "$RUN_DIR" "$(process_service "$1")"
}

identity_file() {
  printf '%s/%s.identity\n' "$RUN_DIR" "$(process_service "$1")"
}

log_file() {
  printf '%s/%s.log\n' "$LOG_DIR" "$(process_service "$1")"
}

is_running_pid() {
  pid=$1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  file=$(pid_file "$1")
  [ -f "$file" ] && sed -n '1p' "$file" || true
}

proc_start_ticks() {
  pid=$1
  awk '{print $22}' "/proc/$pid/stat" 2>/dev/null || true
}

proc_cmdline() {
  pid=$1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed 's/[[:space:]]*$//' || true
}

write_identity() {
  service=$1
  pid=$2
  binary=$(readlink -f "$(service_binary "$service")")
  cfg=$(readlink -f "$(service_config "$service")")
  {
    printf 'pid=%s\n' "$pid"
    printf 'exe=%s\n' "$binary"
    printf 'config=%s\n' "$cfg"
    printf 'start_ticks=%s\n' "$(proc_start_ticks "$pid")"
    printf 'cmdline=%s\n' "$(proc_cmdline "$pid")"
  } >"$(identity_file "$service")"
}

identity_value() {
  key=$1
  file=$2
  sed -n "s/^$key=//p" "$file" 2>/dev/null | head -n 1
}

pid_identity_matches() {
  service=$1
  pid=$2
  ident=$(identity_file "$service")
  [ -f "$ident" ] || return 1
  expected_exe=$(identity_value exe "$ident")
  expected_cfg=$(identity_value config "$ident")
  expected_ticks=$(identity_value start_ticks "$ident")
  expected_cmd=$(identity_value cmdline "$ident")
  actual_exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
  actual_exe_clean=${actual_exe% (deleted)}
  actual_ticks=$(proc_start_ticks "$pid")
  actual_cmd=$(proc_cmdline "$pid")
  cfg=$(readlink -f "$(service_config "$service")")
  [ -n "$actual_exe_clean" ] && [ "$actual_exe_clean" = "$expected_exe" ] && \
    [ "$cfg" = "$expected_cfg" ] && \
    [ -n "$actual_ticks" ] && [ "$actual_ticks" = "$expected_ticks" ] && \
    [ -n "$actual_cmd" ] && [ "$actual_cmd" = "$expected_cmd" ]
}

service_port_values() {
  cfg=$(service_config "$1")
  [ -f "$cfg" ] || return 0
  awk -F= '
    $1 ~ /^[[:space:]]*(grpc_listen|rest_listen)[[:space:]]*$/ {
      gsub(/[[:space:]"]/, "", $2);
      n = split($2, p, ":");
      if (n > 1) print p[n];
    }
  ' "$cfg"
}

config_value() {
  key=$1
  cfg=$2
  awk -F= -v key="$key" '
    $1 ~ "^[[:space:]]*" key "[[:space:]]*$" {
      gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", $2);
      print $2;
      exit;
    }
  ' "$cfg"
}

rest_url() {
  cfg=$(service_config "$1")
  rest=$(config_value rest_listen "$cfg")
  [ -n "$rest" ] || return 1
  case "$rest" in
    0.0.0.0:*) rest="127.0.0.1:${rest##*:}" ;;
    "[::]:"*) rest="127.0.0.1:${rest##*:}" ;;
  esac
  printf 'http://%s/health\n' "$rest"
}

mount_paths_for_target() {
  cfg=$(service_config "$1")
  case "$1" in
    dfs) printf 'dfs:%s\n' "$(config_value dfs_mount "$cfg")" ;;
    ownerfs) printf 'ownerfs:%s\n' "$(config_value ownerfs_mount "$cfg")" ;;
    node)
      printf 'dfs:%s\n' "$(config_value dfs_mount "$cfg")"
      printf 'ownerfs:%s\n' "$(config_value ownerfs_mount "$cfg")"
      ;;
    meta) return 0 ;;
  esac
}

mount_source() {
  case "$1" in
    dfs) printf 'afs-dfs\n' ;;
    ownerfs) printf 'afs-ownerfs\n' ;;
    meta|node) return 0 ;;
  esac
}

verify_service_mount() {
  local mount_service=$1
  mount=$2
  expected_source=$(mount_source "$mount_service" || true)
  [ -n "$mount" ] || return 0
  command -v findmnt >/dev/null 2>&1 || {
    echo "findmnt is required to verify $mount_service mount readiness" >&2
    return 1
  }
  target=$(findmnt -rn --mountpoint "$mount" -o TARGET 2>/dev/null || true)
  fstype=$(findmnt -rn --mountpoint "$mount" -o FSTYPE 2>/dev/null || true)
  source=$(findmnt -rn --mountpoint "$mount" -o SOURCE 2>/dev/null || true)
  if [ -z "$target" ]; then
    echo "$mount_service mount is not an exact mount point: $mount" >&2
    return 1
  fi
  real_mount=$(readlink -f "$mount")
  real_target=$(readlink -f "$target" 2>/dev/null || true)
  if [ -z "$real_target" ] || [ "$real_target" != "$real_mount" ]; then
    echo "$mount_service mount point mismatch for $mount: found $target" >&2
    return 1
  fi
  case "$fstype" in
    fuse|fuse.*) ;;
    *) echo "$mount_service mount is not FUSE at $mount: fstype=$fstype" >&2; return 1 ;;
  esac
  if [ "$source" != "$expected_source" ]; then
    echo "$mount_service mount source mismatch at $mount: expected $expected_source got $source" >&2
    return 1
  fi
}

port_in_use() {
  port=$1
  if command -v ss >/dev/null 2>&1; then
    ss -H -ltn "sport = :$port" | grep -q .
  else
    return 1
  fi
}

unmount_service_mount() {
  local mount_service=$1
  mount=$2
  [ -n "$mount" ] || return 0
  command -v findmnt >/dev/null 2>&1 || {
    echo "findmnt is required to verify $mount_service unmount" >&2
    return 1
  }
  if ! findmnt -rn --mountpoint "$mount" >/dev/null 2>&1; then
    return 0
  fi
  expected_source=$(mount_source "$mount_service" || true)
  source=$(findmnt -rn --mountpoint "$mount" -o SOURCE 2>/dev/null || true)
  if [ "$source" != "$expected_source" ]; then
    echo "refusing to unmount $mount_service at $mount: source=$source expected=$expected_source" >&2
    return 1
  fi
  if command -v fusermount3 >/dev/null 2>&1; then
    fusermount3 -u "$mount" 2>/dev/null || umount "$mount"
  elif command -v fusermount >/dev/null 2>&1; then
    fusermount -u "$mount" 2>/dev/null || umount "$mount"
  else
    umount "$mount"
  fi
  if findmnt -rn --mountpoint "$mount" >/dev/null 2>&1; then
    echo "$mount_service mount still present after unmount: $mount" >&2
    return 1
  fi
}

unmount_target_mounts() {
  service=$1
  while IFS=: read -r mount_service mount; do
    [ -n "$mount" ] || continue
    unmount_service_mount "$mount_service" "$mount"
  done <<EOF_MOUNTS
$(mount_paths_for_target "$service" || true)
EOF_MOUNTS
}

wait_readiness() {
  service=$1
  pid=$2
  url=$(rest_url "$service" || true)
  deadline=$((SECONDS + TIMEOUT))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! is_running_pid "$pid"; then
      echo "$service exited during startup; see $(log_file "$service")" >&2
      return 1
    fi
    if [ -n "$url" ] && command -v curl >/dev/null 2>&1; then
      if curl -fsS --max-time 2 "$url" 2>/dev/null | grep -q '"status":"ready"'; then
        mounts_ok=1
        while IFS=: read -r mount_service mount; do
          [ -n "$mount" ] || continue
          verify_service_mount "$mount_service" "$mount" || { mounts_ok=0; break; }
        done <<EOF_MOUNTS
$(mount_paths_for_target "$service" || true)
EOF_MOUNTS
        if [ "$mounts_ok" -eq 1 ]; then return 0; fi
        sleep 1
        continue
      fi
    elif [ -z "$url" ]; then
      return 0
    fi
    sleep 1
  done
  echo "$service did not become ready within ${TIMEOUT}s; see $(log_file "$service")" >&2
  return 1
}

assert_ready_to_start() {
  service=$1
  binary=$(service_binary "$service")
  cfg=$(service_config "$service")
  [ -x "$binary" ] || { echo "missing executable: $binary" >&2; exit 1; }
  [ -f "$cfg" ] || { echo "missing config: $cfg" >&2; exit 1; }

  pid=$(read_pid "$service")
  if is_running_pid "$pid"; then
    if pid_identity_matches "$service" "$pid"; then
      echo "$service already running with pid $pid" >&2
      exit 1
    fi
    echo "$service pid file points to another live process: $pid" >&2
    exit 1
  fi
  if [ -n "$pid" ]; then
    echo "removing stale pid file for $service: $pid" >&2
    rm -f "$(pid_file "$service")" "$(identity_file "$service")"
  fi

  for port in $(service_port_values "$service"); do
    if port_in_use "$port"; then
      echo "$service port already in use: $port" >&2
      exit 1
    fi
  done
}

start_one() {
  service=$1
  lock="$RUN_DIR/$service.start.lock"
  if ! mkdir "$lock" 2>/dev/null; then
    echo "$service start is already in progress" >&2
    exit 1
  fi
  trap 'rm -rf "$lock"' EXIT
  assert_ready_to_start "$service"
  binary=$(service_binary "$service")
  cfg=$(service_config "$service")
  log=$(log_file "$service")
  if [ "$(id -u)" -eq 0 ] && [ "$(process_service "$service")" != "meta" ]; then
    while IFS=: read -r _ mount; do [ -n "$mount" ] && mkdir -p "$mount"; done <<EOF_MOUNTS
$(mount_paths_for_target node || true)
EOF_MOUNTS
  fi
  nohup "$binary" --config "$cfg" >>"$log" 2>&1 &
  pid=$!
  printf '%s\n' "$pid" >"$(pid_file "$service")"
  write_identity "$service" "$pid"
  if [ "$READINESS" -eq 1 ]; then
    if ! wait_readiness "$service" "$pid"; then
      if is_running_pid "$pid"; then
        kill "$pid" 2>/dev/null || true
        sleep 1
        is_running_pid "$pid" && kill -9 "$pid" 2>/dev/null || true
      fi
      rm -f "$(pid_file "$service")" "$(identity_file "$service")"
      exit 1
    fi
    echo "started $service pid=$pid ready=true"
  else
    sleep 1
    if ! is_running_pid "$pid"; then
      echo "$service exited during startup; see $log" >&2
      rm -f "$(pid_file "$service")" "$(identity_file "$service")"
      exit 1
    fi
    echo "started $service pid=$pid ready=skipped"
  fi
  rm -rf "$lock"
  trap - EXIT
}

stop_one() {
  service=$1
  pid=$(read_pid "$service")
  if ! is_running_pid "$pid"; then
    rm -f "$(pid_file "$service")" "$(identity_file "$service")"
    echo "$service stopped"
    return 0
  fi
  if ! pid_identity_matches "$service" "$pid"; then
    if ! is_running_pid "$pid"; then
      rm -f "$(pid_file "$service")" "$(identity_file "$service")"
      echo "$service stopped"
      return 0
    fi
    echo "$service pid file points to another live process: $pid" >&2
    return 1
  fi
  kill "$pid"
  deadline=$((SECONDS + TIMEOUT))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! is_running_pid "$pid"; then
      rm -f "$(pid_file "$service")" "$(identity_file "$service")"
      echo "$service stopped"
      return 0
    fi
    sleep 1
  done
  echo "$service did not stop within ${TIMEOUT}s" >&2
  return 1
}

status_one() {
  service=$1
  pid=$(read_pid "$service")
  state=stopped
  if is_running_pid "$pid"; then
    if pid_identity_matches "$service" "$pid"; then
      state=running
    else
      state=pid-mismatch
    fi
  else
    pid=
  fi
  if [ "$JSON" -eq 1 ]; then
    printf '{"service":"%s","state":"%s","pid":"%s","config":"%s","log":"%s"}\n' \
      "$service" "$state" "$pid" "$(service_config "$service")" "$(log_file "$service")"
  else
    printf '%s %s' "$service" "$state"
    [ -n "$pid" ] && printf ' pid=%s' "$pid"
    printf '\n'
  fi
}

remove_program_files() {
  rm -f     "$PREFIX/bin/afs-meta"     "$PREFIX/bin/afs-node"     "$PREFIX/bin/dep02-smoke.sh"     "$PREFIX/manifest.json"     "$PREFIX/DEPENDENCIES.md"
  rm -f "$PREFIX/bin/afs-processctl"
}

targets_start() {
  if [ "$TARGET" = all ]; then
    printf 'meta\nnode\n'
  else
    printf '%s\n' "$TARGET"
  fi
}

targets_stop() {
  if [ "$TARGET" = all ]; then
    printf 'node\nmeta\n'
  else
    printf '%s\n' "$TARGET"
  fi
}

targets_mounts() {
  if [ "$TARGET" = all ]; then
    printf 'node\n'
  else
    printf '%s\n' "$TARGET"
  fi
}

case "$ACTION" in
  start)
    for service in $(targets_start); do start_one "$service"; done
    ;;
  stop)
    for service in $(targets_stop); do stop_one "$service"; done
    ;;
  restart)
    for service in $(targets_stop); do stop_one "$service"; done
    for service in $(targets_start); do start_one "$service"; done
    ;;
  status)
    for service in $(targets_start); do status_one "$service"; done
    ;;
  uninstall)
    for service in $(targets_stop); do stop_one "$service"; done
    for service in $(targets_mounts); do unmount_target_mounts "$service"; done
    remove_program_files
    echo "program files removed; persistent data and config preserved"
    ;;
esac
