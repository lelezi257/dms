+            txn.conditions
+                .push(TxnCondition::EntityEquals(MetaEntity::DfsCopy(copy)));
+        }
+        for copy in changed_copies {
+            txn.mutations
+                .push(TxnMutation::Put(MetaEntity::DfsCopy(copy)));
+        }
