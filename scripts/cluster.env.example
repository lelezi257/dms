# Copy to config/dms.env on each runtime node. The default is a single-VM
# localhost deployment; multi-node deployments must set each node's reachable
# IP address and update DMS_META_ENDPOINT/DMS_CLIENT_ENDPOINT accordingly.
DMS_NODE_ID=node-n1
DMS_META_NODE_ID=meta-n1
DMS_META_BIND=0.0.0.0:19300
DMS_META_STATUS_BIND=0.0.0.0:19100
DMS_META_ENDPOINT=http://127.0.0.1:19300
# For multi-node use, this must be the node's reachable cluster IP, not
# 0.0.0.0 or 127.0.0.1. Meta publishes the address to peer Nodes for
# cross-node reads.
DMS_NODE_IP=127.0.0.1
DMS_WORKER_PORT=19200
DMS_NODE_STATUS_BIND=0.0.0.0:19000
DMS_CLIENT_ENDPOINT=http://127.0.0.1:19200
DMS_CLIENT_METRICS_BIND=0.0.0.0:19400
DMS_ARENA_CAPACITY_BYTES=1073741824
DMS_STAGING_TTL_MILLIS=30000
DMS_LOG_LEVEL=info
DMS_LOG_FORMAT=json
DMS_LOG_MAX_FILE_SIZE_BYTES=268435456
DMS_LOG_MAX_BACKUPS=14
DMS_LOG_MAX_AGE_SECONDS=604800
# Trace 默认关闭；启用时，各进程把 OTLP 发到运行 Alloy 的节点。
DMS_TRACING_ENABLED=false
DMS_TRACING_PERIODIC_OPERATIONS=false
DMS_TRACING_OTLP_ENDPOINT=http://127.0.0.1:4317
DMS_TRACING_SAMPLE_RATIO=0.01
