+    pub(crate) fn quarantine_if_invalid(&self, chunk_id: &ChunkId) -> Result<()> {
+        let mut catalog = self
+            .catalog
+            .lock()
+            .map_err(|_| invalid("local chunk catalog lock is poisoned"))?;
+        let Some(record) = catalog.records.get(chunk_id).cloned() else {
+            return Ok(());
+        };
