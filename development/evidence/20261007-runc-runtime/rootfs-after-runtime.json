{
  "observation": "runc adds devices and symlinks after the initially six regular files; not reusable for AFS trusted_tree startup unchanged",
  "entries": [
    {
      "path": "dev/core",
      "mode": "0o777",
      "kind": "symlink",
      "target": "/proc/kcore"
    },
    {
      "path": "dev/fd",
      "mode": "0o777",
      "kind": "symlink",
      "target": "/proc/self/fd"
    },
    {
      "path": "dev/full",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    },
    {
      "path": "dev/null",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    },
    {
      "path": "dev/ptmx",
      "mode": "0o777",
      "kind": "symlink",
      "target": "pts/ptmx"
    },
    {
      "path": "dev/random",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    },
    {
      "path": "dev/stderr",
      "mode": "0o777",
      "kind": "symlink",
      "target": "/proc/self/fd/2"
    },
    {
      "path": "dev/stdin",
      "mode": "0o777",
      "kind": "symlink",
      "target": "/proc/self/fd/0"
    },
    {
      "path": "dev/stdout",
      "mode": "0o777",
      "kind": "symlink",
      "target": "/proc/self/fd/1"
    },
    {
      "path": "dev/tty",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    },
    {
      "path": "dev/urandom",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    },
    {
      "path": "dev/zero",
      "mode": "0o666",
      "kind": "character-device",
      "target": null
    }
  ]
}
