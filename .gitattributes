# Keep raw captured output unchanged, including TAP alignment whitespace.
development/evidence/** -whitespace
# Historical captured evidence is retained for audit and restore, not for
# language statistics. Maintained acceptance/tools/scripts outside this tree
# remain normal source.
development/evidence/** linguist-generated
# Product and process Markdown are documentation.
*.md linguist-documentation
docs/** linguist-documentation
development/**/*.md linguist-documentation
# Vendored upstream dependencies are not owned product source.
third_party/** linguist-vendored
# TSV fixtures deliberately include an empty final exclusion_reason field.
development/acceptance/suites/prepare_ctl_reference.sh whitespace=-blank-at-eol
# Preserve machine-generated checkpoint receipts byte-for-byte.
development/checkpoints/*/results/** whitespace=-blank-at-eol,-blank-at-eof
