+                && device_id == &request.device_id
+                && *device_epoch == request.device_epoch
+            {
+                same_device_seen = true;
+                if *catalog_revision >= request.catalog_revision || copy.state == CopyState::Corrupt
+                {
+                    has_superseding_same_device = true;
+                }
