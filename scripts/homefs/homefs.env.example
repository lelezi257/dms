# Copy to a private writable location on each Linux node; do not commit the actual token.
DMS_HOME_NODE_ID=A
DMS_HOME_CENTER_RPC=192.168.104.11:31991
DMS_HOME_CENTER_HTTP=192.168.104.11:31992
DMS_HOME_CENTER_STATE=/var/lib/dms-home/center.json
DMS_HOME_NFS_ENDPOINT=192.168.104.10:/
DMS_HOME_P2P_ADDRESS=192.168.104.10:31993
DMS_HOME_DATA_ROOT=/var/lib/dms-home/data
DMS_HOME_PEER_MOUNTS=/var/lib/dms-home/peers
DMS_HOME_FUSE_MOUNT=/mnt/dms-home
DMS_HOME_BACKEND=nfs
DMS_HOME_TOKEN=change-to-a-shared-private-token
