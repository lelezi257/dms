{
  "schema": "dms.whitebox-contract.v1",
  "description": "基础数据路径的固定 Case、前台调用图和 payload 内存账本。修改这些数字必须先证明语义变化，不能用实现现状倒推最小值。",
  "sizes_bytes": [4096, 65536, 1048576],
  "legacy_baseline": {
    "file": "benchmarks/whitebox/baselines/lima-aarch64-2026-09-12.json",
    "role": "external KV / Adapter 回归基线",
    "dms_source_sha": "d0852777f44284aaabfae84b2c15dc686da99248",
    "note": "该基线冻结的是历史候选，不是当前 HEAD；当前 HEAD 需要另行生成 candidate 结果。"
  },
  "unified_node_runtime_workload": {
    "schema": "dms.unified-node-runtime-workload.v1",
    "description": "最小 12 文件 workload，用来覆盖 create/read/middle-range-write/delete、node-hot/takeover，并避免只测本地读写。",
    "files": {
      "4KiB": 8,
      "64KiB": 3,
      "1MiB": 1
    },
    "operations": [
      "create",
      "read_full",
      "middle_range_write",
      "delete",
      "node_hot_read",
      "takeover_first_read",
      "takeover_second_same_range_read"
    ],
    "entrypoints": ["kv", "fs", "image"],
    "comparison_note": "FS/Image 是 dms-node 进程内子系统，必须从 Object/Range 进入 DataCore，不能通过本地 Worker RPC 绕回外部 SDK。"
  },
  "required_path_ledger_fields": [
    "entry_worker_rpc",
    "node_meta_resolve",
    "node_meta_commit",
    "node_meta_report",
    "node_peer_pull_count",
    "node_peer_pull_bytes",
    "current_cache_hit",
    "current_cache_miss",
    "payload_full_copy",
    "payload_allocation"
  ],
  "thresholds": {
    "max_p50_regression_ratio": 1.10,
    "max_unattributed_fraction": 0.10,
    "local_hot_max_lower_bound_ratio": 1.50,
    "architecture_penalty_max_lower_bound_ratio": 1.25
  },
  "cases": [
    {
      "id": "sdk.local_hot_get.4096",
      "path_class": "local_hot",
      "foreground_calls": ["Client->local Node:Get"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "调用者只有 key；Node 用 Current cache 确认版本并保护本地 bytes，然后从 SHM 复制到用户 buffer。"
    },
    {
      "id": "sdk.local_hot_get.1048576",
      "path_class": "local_hot",
      "foreground_calls": ["Client->local Node:Get"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "与 4 KiB 相同；对象变大只增加必要的 SHM 到用户 buffer 复制。"
    },
    {
      "id": "sdk.local_set.4096",
      "path_class": "architecture_penalty",
      "foreground_calls": ["Client->local Node:SetInline", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 2,
      "minimum_payload_allocations": 1,
      "reason": "小对象随 SetInline 发送；Meta 提交负责发布全局 Current，不能省略。"
    },
    {
      "id": "sdk.local_set.1048576",
      "path_class": "advantaged",
      "foreground_calls": ["Client->local Node:AllocateStaging", "Client->local Node:Set", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 3,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 1,
      "reason": "SHM 写先取得 Node 管理的 Slot，再 seal；payload 不经过 Upload RPC。"
    },
    {
      "id": "sdk.peer_first_get.4096",
      "path_class": "architecture_penalty",
      "foreground_calls": ["Client->reader Node:Get", "reader Node->Meta:ResolveObject", "reader Node->owner Node:PullBlock"],
      "minimum_rpc": 3,
      "minimum_payload_copies": 3,
      "minimum_payload_allocations": 2,
      "reason": "reader Node 首次没有位置和 bytes；副本登记在后台完成，不计入用户等待路径。"
    },
    {
      "id": "sdk.peer_first_get.1048576",
      "path_class": "architecture_penalty",
      "foreground_calls": ["Client->reader Node:Get", "reader Node->Meta:ResolveObject", "reader Node->owner Node:PullBlock"],
      "minimum_rpc": 3,
      "minimum_payload_copies": 3,
      "minimum_payload_allocations": 2,
      "reason": "与 4 KiB 相同；大对象主要增加 Peer payload 传输成本。"
    },
    {
      "id": "sdk.peer_hot_get.4096",
      "path_class": "advantaged",
      "foreground_calls": ["Client->reader Node:Get"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "首读已在 reader Node 安装 Current 和本地副本；后续只走本地读取。"
    },
    {
      "id": "sdk.peer_hot_get.1048576",
      "path_class": "advantaged",
      "foreground_calls": ["Client->reader Node:Get"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "与 4 KiB 相同；大对象收益来自不再跨 Node 搬运 payload。"
    },
    {
      "id": "juicefs.create.4096",
      "path_class": "advantaged",
      "foreground_calls": ["Client->local Node:SetInline", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 2,
      "minimum_payload_allocations": 1,
      "reason": "Adapter 直接把已知长度 Reader 交给 SDK，没有额外 Stat/Get。"
    },
    {
      "id": "juicefs.create.1048576",
      "path_class": "advantaged",
      "foreground_calls": ["Client->local Node:AllocateStaging", "Client->local Node:Set", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 3,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 1,
      "reason": "Adapter 复用 SDK 的 SHM 大对象写路径，不额外 ReadAll。"
    },
    {
      "id": "juicefs.read.4096",
      "path_class": "advantaged",
      "foreground_calls": ["JuiceFS range #1->local Node:Get"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "Adapter 只建立 Reader；单个 4 KiB 范围读没有预先 Stat。"
    },
    {
      "id": "juicefs.read.1048576",
      "path_class": "advantaged",
      "foreground_calls": ["JuiceFS range #1->local Node:Get", "JuiceFS range #2->local Node:Get"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "固定挂载参数下，Chunk 层把 1 MiB 顺序读拆成两个并行范围读；两种对象后端调用图一致。"
    },
    {
      "id": "juicefs.overwrite.4096",
      "path_class": "advantaged",
      "foreground_calls": ["Client->local Node:SetInline", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 2,
      "minimum_payload_allocations": 1,
      "reason": "固定 Case 覆盖 4 KiB，JuiceFS 发布一个新的小 Slice 对象。"
    },
    {
      "id": "juicefs.overwrite.1048576",
      "path_class": "advantaged",
      "foreground_calls": ["Client->local Node:SetInline", "local Node->Meta:CommitVersion"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 2,
      "minimum_payload_allocations": 1,
      "reason": "文件大小为 1 MiB，但固定 Case 只覆盖 4 KiB，DMS 接收的仍是一个小 Slice。"
    },
    {
      "id": "kv.get_range.local_hot.4096",
      "entrypoint": "kv",
      "path_class": "local_hot",
      "requires_path_ledger": true,
      "foreground_calls": ["Rust/Go SDK->local Node:GetRange"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "外部 KV SDK 保持薄 Client；get_range 仍通过 Worker RPC 进入本地 Node，再由 Node 返回目标 range。"
    },
    {
      "id": "fs.create.4096",
      "entrypoint": "fs",
      "path_class": "advantaged",
      "requires_path_ledger": true,
      "foreground_calls": ["FileOperations->DataCore:PutIfAbsent", "DataCore->Meta:CommitVersion"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 1,
      "reason": "FUSE 类入口已经在 dms-node 内部，不能再走 Client->Worker RPC；只保留发布版本所需的 Meta commit。"
    },
    {
      "id": "fs.read.node_hot.4096",
      "entrypoint": "fs",
      "path_class": "local_hot",
      "requires_path_ledger": true,
      "foreground_calls": ["FileOperations->DataCore:GetRange"],
      "minimum_rpc": 0,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "本节点已持有 Current 和 bytes；FileOperations 只把 DataCore 保护的 range 交付给内核目标 buffer。"
    },
    {
      "id": "fs.middle_range_write.65536",
      "entrypoint": "fs",
      "path_class": "advantaged",
      "requires_path_ledger": true,
      "foreground_calls": ["FileOperations->DataCore:WriteRange", "DataCore->Meta:ResolveObject", "DataCore->Meta:CommitVersion"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 1,
      "reason": "64 KiB 文件中段覆盖只产生新的 range/version 片段；不通过 KV SDK，也不预读整对象。首版仍需拿到 base layout 后再提交 overlay，后续可通过缓存 layout API 把热路径降到 1 次 Meta commit。"
    },
    {
      "id": "fs.delete.4096",
      "entrypoint": "fs",
      "path_class": "advantaged",
      "requires_path_ledger": true,
      "foreground_calls": ["FileOperations->DataCore:DeleteObject", "DataCore->Meta:CommitVersion"],
      "minimum_rpc": 1,
      "minimum_payload_copies": 0,
      "minimum_payload_allocations": 0,
      "reason": "删除是纯元数据版本提交；进程内 FileOperations 不能产生 Worker RPC 或 payload copy。"
    },
    {
      "id": "image.lazy_first_range.65536",
      "entrypoint": "image",
      "path_class": "architecture_penalty",
      "requires_path_ledger": true,
      "foreground_calls": ["ImageReader->DataCore:GetRange", "DataCore->Meta:ResolveObject", "DataCore->owner Node:PullBlock"],
      "minimum_rpc": 2,
      "minimum_payload_copies": 2,
      "minimum_payload_allocations": 1,
      "reason": "Image/lazy 入口第一次读取远端 range 时仍需要解析位置并从 owner 拉取；但入口本身不经过 Worker RPC。"
    },
    {
      "id": "image.lazy_second_same_range.65536",
      "entrypoint": "image",
      "path_class": "advantaged",
      "requires_path_ledger": true,
      "second_same_range_peer_bytes_must_be_zero": true,
      "foreground_calls": ["ImageReader->DataCore:GetRange"],
      "minimum_rpc": 0,
      "minimum_payload_copies": 1,
      "minimum_payload_allocations": 0,
      "reason": "同一 Image range 第二次读取必须复用 Node Cache / in-flight 结果，不再产生 Peer payload。"
    }
  ]
}
