{
  "schema": "dms.native-filesystem-vs-glue-contract.v1",
  "description": "在同一组 Linux VM、同一份 DMS 构建、同一文件语料和相同非持久化元数据模式下，对比进程内 Native Filesystem 与外置 Glue。先验证路径合同，再比较时延；持久化模式另立可靠性性能合同。payload_copy_stages 表示任意一个数据段从调用入口到稳定存储或用户缓冲区经历的应用层完整字节复制阶段数，不表示一个逻辑文件操作内所有分段复制次数的总和。",
  "workload": {
    "file_count": 200,
    "files_by_size": {
      "4096": 140,
      "65536": 50,
      "1048576": 10
    },
    "middle_overwrite": {
      "source_size": 65536,
      "offset": 32768,
      "length": 4096
    }
  },
  "thresholds": {
    "minimum_samples_per_case": 30,
    "native_p50_must_be_lower": true,
    "max_native_p95_ratio": 1.05,
    "minimum_local_hot_improvement": 0.15,
    "minimum_create_improvement": 0.15,
    "minimum_middle_overwrite_improvement": 0.15,
    "minimum_peer_first_read_improvement": 0.05,
    "max_unattributed_fraction": 0.10
  },
  "cases": [
    {
      "id": "create_write.4096",
      "class": "create",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 1,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 1,
        "peer_pull": 0,
        "payload_copy_stages": 2
      }
    },
    {
      "id": "create_write.65536",
      "class": "create",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 1,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 1,
        "peer_pull": 0,
        "payload_copy_stages": 2
      }
    },
    {
      "id": "create_write.1048576",
      "class": "create",
      "rationale": "当前 Linux FUSE 请求边界把一次 1 MiB write(2) 分成两个 callback；write-through 要求每个 callback 返回前发布，因此两次 commit 是不引入 writeback 时的最小值。",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 1,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 2,
        "peer_pull": 0,
        "payload_copy_stages": 2
      }
    },
    {
      "id": "local_hot_read.4096",
      "class": "local_hot",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 0,
        "filesystem_meta_commit": 0,
        "peer_pull": 0,
        "payload_copy_stages": 1
      }
    },
    {
      "id": "local_hot_read.65536",
      "class": "local_hot",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 0,
        "filesystem_meta_commit": 0,
        "peer_pull": 0,
        "payload_copy_stages": 1
      }
    },
    {
      "id": "local_hot_read.1048576",
      "class": "local_hot",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 0,
        "filesystem_meta_commit": 0,
        "peer_pull": 0,
        "payload_copy_stages": 1
      }
    },
    {
      "id": "peer_first_read.4096",
      "class": "peer_first_read",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 0,
        "peer_pull": 1,
        "payload_copy_stages": 3
      }
    },
    {
      "id": "peer_first_read.65536",
      "class": "peer_first_read",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 0,
        "peer_pull": 1,
        "payload_copy_stages": 3
      }
    },
    {
      "id": "peer_first_read.1048576",
      "class": "peer_first_read",
      "rationale": "两次 write-through callback 产生两个不可变 Block；首次接管每个尚未本地化的 Block 各 Pull 一次，热读随后为零次。",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 1,
        "filesystem_meta_commit": 0,
        "peer_pull": 2,
        "payload_copy_stages": 3
      }
    },
    {
      "id": "middle_overwrite.65536",
      "class": "middle_overwrite",
      "native_path": {
        "frontend_worker_rpc": 0,
        "filesystem_meta_create": 0,
        "filesystem_meta_lookup": 0,
        "filesystem_meta_commit": 1,
        "peer_pull": 0,
        "payload_copy_stages": 2
      }
    }
  ]
}
