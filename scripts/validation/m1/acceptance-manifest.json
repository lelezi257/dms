{
  "schema": "dms.m1.acceptance-manifest.v1",
  "milestone": "M1 Shared POSIX Foundation",
  "policy": {
    "release_requires_clean_source": true,
    "release_allows_skips": false,
    "release_allows_planned_cases": false,
    "unexpected_case_is_failure": true
  },
  "requirements": [
    {
      "id": "M1-NS",
      "stage": "M1.1",
      "claim": "多节点共享同一棵权威目录树，并保持 namespace mutation 的原子性、幂等性和返回后可见性。"
    },
    {
      "id": "M1-SIZE",
      "stage": "M1.2",
      "claim": "文件尺寸、稀疏区间、追加和中段覆盖通过同一版本提交合同发布。"
    },
    {
      "id": "M1-LIFE",
      "stage": "M1.3",
      "claim": "hard link、symlink、unlink-open、FORGET 与 inode/object 回收遵守稳定文件身份和引用生命周期。"
    },
    {
      "id": "M1-ATTR",
      "stage": "M1.4",
      "claim": "属性、权限、xattr、ACL 与容量查询由同一个 Meta FilesystemCatalog 权威管理。"
    },
    {
      "id": "M1-SPACE",
      "stage": "M1.5",
      "claim": "空间预留、打洞、同步调用和同步打开标志遵守 write-through 与唯一 Arena owner 合同。"
    },
    {
      "id": "M1-LOCK",
      "stage": "M1.6a",
      "claim": "fcntl/flock 跨节点冲突、等待、中断和故障回收由 Meta 唯一锁 owner 线性化。"
    },
    {
      "id": "M1-MMAP",
      "stage": "M1.6b",
      "claim": "cached mmap 复用 Linux page cache，并保持 write-through、远端失效和越 EOF 行为。"
    },
    {
      "id": "M1-DIST",
      "stage": "M1.7",
      "claim": "跨节点缓存、Watch、Peer pull 和重启恢复不能产生旧读、双 Current 或混合版本。"
    },
    {
      "id": "M1-INTEGRITY",
      "stage": "M1.7",
      "claim": "随机写、截断、打洞和 mmap workload 完成后逐字节校验正确。"
    },
    {
      "id": "M1-PERF",
      "stage": "M1.7",
      "claim": "Native Filesystem 保持冻结的 RPC、复制、资源和性能路径合同。"
    },
    {
      "id": "M1-DELIVERY",
      "stage": "M1.7",
      "claim": "全新 Linux 环境能够构建、部署、挂载、观测和运行单 VM/三 VM 验收。"
    }
  ],
  "cases": [
    {
      "id": "namespace-single-vm",
      "requirement_ids": [
        "M1-NS"
      ],
      "title": "单 VM 双 Node namespace 与重启恢复",
      "category": "posix",
      "implementation_status": "implemented",
      "tiers": [
        "fast",
        "full"
      ],
      "topologies": [
        "single-vm"
      ],
      "executor": "scripts/validation/run_filesystem_namespace_e2e.sh",
      "expected": "共享目录 mutation、真分页、跨挂载可见与 Meta/Node 重启恢复全部通过。",
      "invariants": [
        "single_meta_namespace_owner",
        "no_visibility_ack_before_remote_revoke"
      ]
    },
    {
      "id": "namespace-three-vm",
      "requirement_ids": [
        "M1-NS",
        "M1-DIST"
      ],
      "title": "三 VM namespace 一致性",
      "category": "distributed",
      "implementation_status": "implemented",
      "tiers": [
        "full"
      ],
      "topologies": [
        "three-vm"
      ],
      "executor": "scripts/validation/run_filesystem_namespace_3vm.py",
      "expected": "独立 Meta 与两个 Node 上同名并发、rename/unlink/readdir 和恢复结果一致。",
      "invariants": [
        "one_winner_for_same_name_create",
        "directory_revision_monotonic"
      ]
    },
    {
      "id": "size-single-vm",
