{
  "schema": "dms.native-vs-moosefs-contract.v1",
  "description": "同一组三台 VM、相同 FUSE/POSIX workload 下比较 DMS Native Filesystem 与 MooseFS。memory lane 才是公平 payload 介质对比；disk lane 单独展示真实 MooseFS 磁盘部署。验收目标是得到可复现、白盒可解释的 Preview 判定，不预设 DMS 必须获胜。",
  "topology": {
    "A": "writer and data owner",
    "B": "remote reader",
    "C": "metadata service",
    "moosefs_goal": 1
  },
  "workload": {
    "workspace_files": {
      "4096": 120,
      "65536": 40
    },
    "large_file_bytes": 536870912,
    "required_cases": [
      "workspace.create",
      "workspace.local_hot",
      "workspace.stat",
      "workspace.peer_first",
      "workspace.peer_repeat",
      "workspace.patch",
      "workspace.create_delete",
      "sequential_512m.write",
      "sequential_512m.local_read",
      "sequential_512m.peer_first",
      "sequential_512m.peer_repeat"
    ]
  },
  "evidence": {
    "minimum_paired_memory_rounds": 5,
    "required_latency_percentiles": ["p50", "p95", "p99"],
    "required_resource_ledgers": ["network", "cpu_ticks", "context_switches", "rss_peak_bytes", "copy_evidence"],
    "require_architecture_and_implementation_classification": true,
    "require_preview_verdict": true
  }
}
