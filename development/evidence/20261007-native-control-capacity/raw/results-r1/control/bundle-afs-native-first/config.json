{
  "hostname": "afs-native-workspace",
  "linux": {
    "namespaces": [
      {
        "type": "mount"
      },
      {
        "type": "pid"
      },
      {
        "type": "network"
      },
      {
        "type": "ipc"
      },
      {
        "type": "uts"
      },
      {
        "type": "cgroup"
      }
    ]
  },
  "mounts": [
    {
      "destination": "/proc",
      "options": [
        "nosuid",
        "nodev",
        "noexec"
      ],
      "source": "proc",
      "type": "proc"
    },
    {
      "destination": "/workspace",
      "options": [
        "bind",
        "rw",
        "nosuid",
        "nodev"
      ],
      "source": "/opt/afs-managed-control-capacity-20261007-r1/mount/ownerfs/workspace",
      "type": "bind"
    }
  ],
  "ociVersion": "1.0.2",
  "process": {
    "args": [
      "/afs-workspace-probe",
      "idle"
    ],
    "capabilities": {
      "ambient": [],
      "bounding": [],
      "effective": [],
      "inheritable": [],
      "permitted": []
    },
    "cwd": "/",
    "env": [
      "PATH=/bin:/usr/bin"
    ],
    "noNewPrivileges": true,
    "rlimits": [
      {
        "hard": 256,
        "soft": 256,
        "type": "RLIMIT_NOFILE"
      }
    ],
    "terminal": false,
    "user": {
      "gid": 501,
      "uid": 501
    }
  },
  "root": {
    "path": "/opt/afs-managed-control-capacity-20261007-r1/rootfs",
    "readonly": true
  }
}